{
  "name": "indoor-o-route-analysis",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=web",
    "test": "turbo test",
    "test:run": "turbo test:run",
    "test:e2e": "turbo test:e2e",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "web": "turbo dev --filter=web",
    "mcp-server": "turbo dev --filter=mcp-server",
    "analyse-all": "pnpm --filter analyse-all-cli start",
    "analyse-all-max-leg": "pnpm --filter analyse-all-cli start --max-leg",
    "training": "pnpm --filter training-cli start",
    "analyse": "pnpm --filter analyse-cli start",
    "convert": "pnpm --filter convert-cli start",
    "splits": "pnpm --filter splits-cli start",
    "route-viz": "pnpm --filter route-viz-cli start",
    "update-all": "pnpm analyse-all && pnpm splits && pnpm training"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "turbo": "^2.9.14"
  }
}
